{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "mcpServers": {
    "obsidian": {
      "command": "npx",
      "args": ["-y", "mcp-obsidian"],
      "env": {
        "OBSIDIAN_API_KEY": "${OBSIDIAN_API_KEY}",
        "OBSIDIAN_HOST": "http://localhost:27123"
      }
    }
  }
}
